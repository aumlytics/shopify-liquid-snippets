{% comment %}
  Dynamic Buy Now Pay Later Messaging
  ===================================
  
  Displays real-time installment pricing for BNPL providers that updates
  dynamically when product variants change.
  
  @param {Product} product - Required. The product object
  @param {Variant} current_variant - Required. Currently selected variant
  @param {String} providers - Optional. Comma-separated provider list
  @param {Number} installments - Optional. Number of installments (default: 4)
  @param {Number} min_price - Optional. Minimum price in dollars (default: 50)
  @param {Number} max_price - Optional. Maximum price in dollars (default: 3000)
  @param {Boolean} show_logo - Optional. Show provider logos (default: true)
  @param {Boolean} show_learn_more - Optional. Show learn more links (default: true)
  @param {String} custom_class - Optional. Additional CSS class
  @param {String} position - Optional. Position context for styling
  
  Usage:
  {% render 'dynamic-bnpl-messaging',
    product: product,
    current_variant: product.selected_or_first_available_variant
  %}
{% endcomment %}

{%- comment -%} Set defaults for all parameters {%- endcomment -%}
{%- liquid
  assign enabled_providers = providers | default: 'shoppay,klarna,afterpay,affirm'
  assign num_installments = installments | default: 4
  assign minimum_price = min_price | default: 50
  assign maximum_price = max_price | default: 3000
  assign display_logo = show_logo | default: true
  assign display_learn_more = show_learn_more | default: true
  assign extra_class = custom_class | default: ''
  assign display_position = position | default: 'below-price'
  
  # Convert price thresholds to cents for comparison
  assign min_price_cents = minimum_price | times: 100
  assign max_price_cents = maximum_price | times: 100
  
  # Get current price from variant
  assign current_price = current_variant.price | default: product.price
  
  # Check if product is eligible for BNPL
  # BNPL typically doesn't work with subscriptions or prices outside thresholds
  assign is_subscription = false
  if product.selling_plan_groups.size > 0
    assign is_subscription = true
  endif
  
  assign price_in_range = false
  if current_price >= min_price_cents and current_price <= max_price_cents
    assign price_in_range = true
  endif
  
  assign is_eligible = true
  if is_subscription or price_in_range == false
    assign is_eligible = false
  endif
  
  # Calculate installment amount
  assign installment_amount = current_price | divided_by: num_installments
  
  # Parse enabled providers into array
  assign provider_array = enabled_providers | split: ','
-%}

{%- comment -%} 
  Only render if we have valid data and at least one provider
  We still render the container for JS to potentially show later
{%- endcomment -%}
{%- if product != blank and current_variant != blank -%}

