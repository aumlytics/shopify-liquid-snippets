{% comment %}
  Cart Item Quantity Limit Snippet
  ================================
  Prevents customers from adding more than a specified quantity of a product.
  
  @param {Number} default_limit - Default max quantity (default: 10)
  @param {Boolean} enable_per_product_limits - Use product metafields for limits (default: true)
  @param {String} limit_message - Error message template (default: "Maximum {limit} per order")
  @param {Boolean} show_remaining - Show remaining quantity (default: true)
  @param {String} remaining_message - Remaining quantity message template
  @param {Boolean} enforce_on_cart_page - Enforce on cart page (default: true)
  @param {String} collection_limits - JSON string of collection:limit pairs
  @param {String} excluded_products - Comma-separated product handles to exclude
  @param {String} error_position - "below", "above", or "toast" (default: "below")
  @param {String} animation - "shake", "pulse", or "none" (default: "shake")
{% endcomment %}

{%- comment -%} Set default values for parameters {%- endcomment -%}
{%- liquid
  assign default_limit = default_limit | default: 10
  assign enable_per_product_limits = enable_per_product_limits | default: true
  assign limit_message = limit_message | default: 'Maximum {limit} per order'
  assign show_remaining = show_remaining | default: true
  assign remaining_message = remaining_message | default: '{remaining} remaining'
  assign enforce_on_cart_page = enforce_on_cart_page | default: true
  assign error_position = error_position | default: 'below'
  assign animation = animation | default: 'shake'
  assign excluded_products = excluded_products | default: ''
  
  # Parse excluded products into an array
  assign excluded_array = excluded_products | split: ','
  
  # Build product limits data from cart
  assign cart_data = ''
-%}

{%- comment -%} 
  Build cart quantities data for JavaScript 
  This allows us to track what's already in the cart
{%- endcomment -%}
{%- capture cart_quantities_json -%}
{
  {%- for item in cart.items -%}
    "{{ item.variant_id }}": {
      "quantity": {{ item.quantity }},
      "product_id": {{ item.product_id }},
      "product_handle": "{{ item.product.handle }}",
      "title": {{ item.product.title | json }}
    }{%- unless forloop.last -%},{%- endunless -%}
  {%- endfor -%}
}
{%- endcapture -%}

{%- comment -%}
  Build product limits map
  Priority: Product metafield > Collection limit > Default limit
{%- endcomment -%}
{%- capture product_limits_json -%}
{
  {%- if product -%}
    {%- comment -%} On product page, include current product's limit {%- endcomment -%}
    {%- liquid
      assign product_limit = default_limit
      assign is_excluded = false
      
      # Check if product is excluded
      for excluded in excluded_array
        assign excluded_handle = excluded | strip
        if product.handle == excluded_handle
          assign is_excluded = true
          break
        endif
      endfor
      
      # Get per-product limit from metafield if enabled
      if enable_per_product_limits and product.metafields.custom.quantity_limit
        assign product_limit = product.metafields.custom.quantity_limit
      endif
    -%}
    
    {%- unless is_excluded -%}
      "{{ product.id }}": {
        "limit": {{ product_limit }},
        "handle": "{{ product.handle }}",
        "title": {{ product.title | json }},
        "variants": {
          {%- for variant in product.variants -%}
            "{{ variant.id }}": {
              "limit": {{ product_limit }},
              "title": {{ variant.title | json }}
            }{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        }
      }
    {%- endunless -%}
  {%- endif -%}
}
{%- endcapture -%}

