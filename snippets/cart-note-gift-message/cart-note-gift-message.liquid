    width: 100%;
    box-sizing: border-box;
  }
  
  /* Ensure all children inherit box-sizing */
  .gift-message-wrapper *,
  .gift-message-wrapper *::before,
  .gift-message-wrapper *::after {
    box-sizing: inherit;
  }
  
  /* Container with border */
  .gift-message-container {
    border: 1px solid var(--gift-message-border-color);
    border-radius: var(--gift-message-border-radius);
