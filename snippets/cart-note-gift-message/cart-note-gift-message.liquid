{% comment %}
  Cart Note Gift Message Field
  ============================
  
  A customizable gift message field that saves to cart attributes.
  Merchants can view these messages in the Shopify admin order details.
  
  Usage:
    {% render 'cart-note-gift-message' %}
  
  Parameters:
    - show_by_default: Boolean (default: false) - Start expanded
    - max_characters: Number (default: 250) - Character limit
    - enable_gift_wrap_option: Boolean (default: false) - Show gift wrap checkbox
    - collapsible: Boolean (default: true) - Allow collapse/expand
    - attribute_name: String (default: 'Gift Message') - Cart attribute key
    - gift_wrap_attribute: String (default: 'Gift Wrap Requested') - Gift wrap attribute key
    - placeholder_text: String - Textarea placeholder
    - heading_text: String - Section heading
    - auto_save: Boolean (default: true) - Save as user types
    - auto_save_delay: Number (default: 800) - Debounce delay in ms
  
  Author: Expert Shopify Developer
  Version: 1.0.0
{% endcomment %}

{% comment %} Parameter Defaults {% endcomment %}
{%- liquid
  assign show_by_default = show_by_default | default: false
  assign max_characters = max_characters | default: 250
  assign enable_gift_wrap_option = enable_gift_wrap_option | default: false
  assign collapsible = collapsible | default: true
  assign attribute_name = attribute_name | default: 'Gift Message'
  assign gift_wrap_attribute = gift_wrap_attribute | default: 'Gift Wrap Requested'
  assign placeholder_text = placeholder_text | default: 'Enter your gift message here...'
  assign heading_text = heading_text | default: 'Add a Gift Message'
  assign auto_save = auto_save | default: true
  assign auto_save_delay = auto_save_delay | default: 800
  
  # Generate unique ID for accessibility and multiple instances
  assign unique_id = 'gift-message-' | append: section.id | default: 'gift-message-main'
  
  # Check for existing cart attribute values
  assign existing_message = cart.attributes[attribute_name]
  assign existing_gift_wrap = cart.attributes[gift_wrap_attribute]
  assign is_expanded = show_by_default
  
  # If there's existing content, show expanded
  if existing_message != blank or existing_gift_wrap == 'Yes'
    assign is_expanded = true
  endif
-%}

