{% comment %}
  Product Variant Availability Dropdown
  =====================================
  
  Displays product variant options as accessible dropdowns with sold-out states.
  
  Parameters:
  - product: (required) The product object
  - current_variant: The currently selected variant (default: first available)
  - show_availability_count: Show remaining inventory count (default: false)
  - low_stock_threshold: Threshold for low stock warning (default: 5)
  - sold_out_text: Text for sold out options (default: "Sold Out")
  - low_stock_text: Text for low stock warning (default: "Low Stock")
  - select_text: Prefix for select labels (default: "Select")
  - enable_auto_select: Auto-select first available option (default: true)
  - class_prefix: CSS class prefix (default: "variant-dropdown")
  - id_prefix: ID prefix for elements (default: "ProductVariant")
  
  Usage:
  {% render 'product-variant-availability-dropdown',
    product: product,
    current_variant: product.selected_or_first_available_variant,
    show_availability_count: true
  %}
{% endcomment %}

{%- comment -%} Set default values for parameters {%- endcomment -%}
{%- liquid
  assign current_variant = current_variant | default: product.selected_or_first_available_variant
  assign show_availability_count = show_availability_count | default: false
  assign low_stock_threshold = low_stock_threshold | default: 5
  assign sold_out_text = sold_out_text | default: "Sold Out"
  assign low_stock_text = low_stock_text | default: "Low Stock"
  assign select_text = select_text | default: "Select"
  assign enable_auto_select = enable_auto_select | default: true
  assign class_prefix = class_prefix | default: "variant-dropdown"
  assign id_prefix = id_prefix | default: "ProductVariant"
-%}

{%- comment -%} Only render if product has variants {%- endcomment -%}
{%- if product.has_only_default_variant == false -%}

