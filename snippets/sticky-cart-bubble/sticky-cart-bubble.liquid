    position: absolute;
    /* Position at top-right corner of the bubble */
    top: -4px;
    right: -4px;
    
    /* Minimum size with padding for larger numbers */
    min-width: 22px;
    height: 22px;
    padding: 0 6px;
    
    display: flex;
    align-items: center;
    justify-content: center;
    
    background-color: var(--scb-badge-bg);
    border-radius: 11px;
    
    /* Small border to separate from bubble background */
    border: 2px solid #fff;
    
