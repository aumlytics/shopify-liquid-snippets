{% comment %}
  Sticky Collection Filter Sidebar
  ================================
  Keeps the collection filter sidebar visible while scrolling through products.
  
  @param {Object} collection - Required. The collection object to display filters for.
  @param {Boolean} enable_sticky - Enable sticky behavior. Default: true
  @param {Number} sticky_offset - Pixels from top when sticky. Default: 100
  @param {Number} mobile_breakpoint - Width to switch to mobile drawer. Default: 768
  @param {Boolean} show_filter_count - Show active filter count badge. Default: true
  @param {Boolean} collapse_on_mobile - Auto-collapse on mobile. Default: true
  @param {String} sidebar_width - Width of sidebar. Default: '280px'
  @param {Number} z_index - Z-index for positioning. Default: 100
  @param {Number} animation_duration - Animation duration in ms. Default: 300
{% endcomment %}

{% comment %} Set default values for all parameters {% endcomment %}
{%- liquid
  assign enable_sticky = enable_sticky | default: true
  assign sticky_offset = sticky_offset | default: 100
  assign mobile_breakpoint = mobile_breakpoint | default: 768
  assign show_filter_count = show_filter_count | default: true
  assign collapse_on_mobile = collapse_on_mobile | default: true
  assign sidebar_width = sidebar_width | default: '280px'
  assign z_index = z_index | default: 100
  assign animation_duration = animation_duration | default: 300
-%}

{% comment %} Calculate active filter count for badge display {% endcomment %}
{%- liquid
  assign active_filter_count = 0
  for filter in collection.filters
    assign active_filter_count = active_filter_count | plus: filter.active_values.size
    if filter.type == 'price_range'
      if filter.min_value.value != nil or filter.max_value.value != nil
        assign active_filter_count = active_filter_count | plus: 1
      endif
    endif
  endfor
-%}

{% comment %} 
  Inline Styles
  =============
  We use inline styles scoped to this component to avoid conflicts with theme CSS.
  CSS custom properties allow easy theme customization without modifying the snippet.
{% endcomment %}
<style>
  /* CSS Custom Properties for theming - can be overridden in theme CSS */
  :root {
    --sticky-filter-bg: #ffffff;
    --sticky-filter-border: #e5e5e5;
    --sticky-filter-text: #333333;
    --sticky-filter-text-muted: #666666;
    --sticky-filter-accent: #000000;
    --sticky-filter-accent-hover: #333333;
    --sticky-filter-radius: 8px;
    --sticky-filter-shadow: 0 4px 12px rgba(0, 0, 0, 0.1);
    --sticky-filter-overlay: rgba(0, 0, 0, 0.5);
  }

  /* Main container - uses CSS Grid for layout control */
  .sticky-filter-container {
    display: grid;
    grid-template-columns: {{ sidebar_width }} 1fr;
    gap: 2rem;
    position: relative;
    align-items: start;
  }

  /* 
    Sidebar wrapper - the sticky positioning happens here
    We use position: sticky which is well-supported and performant
    The top value accounts for fixed headers
  */
  .sticky-filter-sidebar {
    {% if enable_sticky %}
    position: sticky;
    top: {{ sticky_offset }}px;
    {% endif %}
    max-height: calc(100vh - {{ sticky_offset }}px - 2rem);
    overflow-y: auto;
    overflow-x: hidden;
    z-index: {{ z_index }};
    background: var(--sticky-filter-bg);
    border: 1px solid var(--sticky-filter-border);
    border-radius: var(--sticky-filter-radius);
    padding: 1.5rem;
    /* Smooth scroll for when content exceeds viewport */
    scroll-behavior: smooth;
    /* Hide scrollbar but maintain functionality */
    scrollbar-width: thin;
    scrollbar-color: var(--sticky-filter-border) transparent;
  }

  /* Custom scrollbar styling for Webkit browsers */
  .sticky-filter-sidebar::-webkit-scrollbar {
    width: 6px;
  }

  .sticky-filter-sidebar::-webkit-scrollbar-track {
    background: transparent;
  }

  .sticky-filter-sidebar::-webkit-scrollbar-thumb {
