    /* Base container - hidden by default, shown via JS */
    .sticky-payment-icons {
      --spi-bg: {{ background_color }};
      --spi-text: {{ text_color }};
      --spi-border: {{ border_color }};
      --spi-icon-size: {{ icon_size }};
      --spi-z-index: {{ z_index }};
      
      position: fixed;
      left: 0;
      right: 0;
      {{ position }}: 0;
      z-index: var(--spi-z-index);
      
      background-color: var(--spi-bg);
      border-{{ position | replace: 'bottom', 'top' | replace: 'top', 'bottom' }}: 1px solid var(--spi-border);
      {%- if shadow %}
      box-shadow: 0 {{ position | replace: 'bottom', '-' | replace: 'top', '' }}4px 12px rgba(0, 0, 0, 0.08);
      {%- endif %}
      border-radius: {{ border_radius }};
      
      padding: {{ bar_padding }};
      
      /* Hidden by default - JS controls visibility */
      opacity: 0;
      visibility: hidden;
      transform: translateY({% if position == 'bottom' %}20px{% else %}-20px{% endif %});
      transition: opacity 0.3s ease, transform 0.3s ease, visibility 0.3s;
      
      /* Ensure it doesn't interfere with page when hidden */
      pointer-events: none;
    }
    
