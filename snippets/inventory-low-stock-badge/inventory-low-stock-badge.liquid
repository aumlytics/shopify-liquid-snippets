{% comment %}
  ============================================================================
  INVENTORY LOW STOCK BADGE
  ============================================================================
  
  A dynamic badge that displays low stock warnings to create purchase urgency.
  
  @param {Object}  product             - Required. The product object
  @param {Number}  threshold           - Optional. Stock level to trigger badge (default: 10)
  @param {Number}  critical_threshold  - Optional. Stock level for critical styling (default: 3)
  @param {String}  display_mode        - Optional. 'exact', 'text', or 'range' (default: 'exact')
  @param {Boolean} show_icon           - Optional. Show warning icon (default: true)
  @param {String}  context             - Optional. 'product' or 'collection' (default: 'product')
  @param {Object}  variant             - Optional. Specific variant to check
  @param {String}  custom_class        - Optional. Additional CSS classes
  @param {String}  badge_style         - Optional. 'pill', 'rounded', 'square' (default: 'pill')
  @param {String}  position            - Optional. 'inline', 'absolute-top', 'absolute-bottom'
  @param {Boolean} animate             - Optional. Enable pulse animation (default: true)
  @param {Boolean} hide_when_zero      - Optional. Hide when out of stock (default: false)
  
  Usage:
  {% render 'inventory-low-stock-badge', product: product, threshold: 10 %}
  
  ============================================================================
{% endcomment %}

{% comment %} ===== CONFIGURATION & DEFAULTS ===== {% endcomment %}
{%- liquid
  # Set default values for all parameters
  # Using | default filter ensures we have sensible fallbacks
  assign threshold = threshold | default: 10
  assign critical_threshold = critical_threshold | default: 3
  assign display_mode = display_mode | default: 'exact'
  assign show_icon = show_icon | default: true
  assign context = context | default: 'product'
  assign badge_style = badge_style | default: 'pill'
  assign position = position | default: 'inline'
  assign animate = animate | default: true
  assign hide_when_zero = hide_when_zero | default: false
  assign custom_class = custom_class | default: ''
  
  # Determine which variant to check
  # Priority: passed variant > selected variant > first available > first variant
  if variant
    assign current_variant = variant
  elsif product.selected_or_first_available_variant
    assign current_variant = product.selected_or_first_available_variant
  else
    assign current_variant = product.variants.first
  endif
  
  # Get inventory information
  # We need to check if inventory is actually being tracked
  assign inventory_quantity = current_variant.inventory_quantity
  assign inventory_policy = current_variant.inventory_policy
  assign inventory_management = current_variant.inventory_management
  
  # Determine if we should show the badge at all
  # Only show for products that track inventory
  assign should_show = false
  assign is_tracked = false
  
  if inventory_management == 'shopify'
    assign is_tracked = true
  endif
  
  # Calculate stock status
  assign is_low_stock = false
  assign is_critical = false
  assign is_sold_out = false
  
  if is_tracked
    if inventory_quantity <= 0
      assign is_sold_out = true
      unless hide_when_zero
        assign should_show = true
      endunless
    elsif inventory_quantity <= critical_threshold
      assign is_critical = true
      assign is_low_stock = true
      assign should_show = true
    elsif inventory_quantity <= threshold
      assign is_low_stock = true
      assign should_show = true
    endif
  endif
  
  # Generate unique ID for this badge instance
  # This allows multiple badges on the same page to work independently
  assign unique_id = 'low-stock-' | append: product.id | append: '-' | append: current_variant.id
-%}

