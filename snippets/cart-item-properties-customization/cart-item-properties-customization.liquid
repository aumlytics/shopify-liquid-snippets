{% comment %}
  Cart Item Properties Customization Snippet
  ==========================================
  
  Purpose: Renders customizable input fields for product personalization.
  These values are captured as line item properties and appear on orders.
  
  Required Parameters:
    - product: The product object
  
  Optional Parameters:
    - enabled: Boolean to enable/disable (default: true)
    - fields: Comma-separated field names (default: 'engraving')
    - section_title: Title for the section (default: 'Personalization')
    - show_preview: Show text preview (default: true)
    - preview_font: Font for preview (default: 'inherit')
  
  Field-specific parameters (prefix with field name):
    - {field}_label: Display label
    - {field}_type: text, textarea, select, checkbox
    - {field}_placeholder: Placeholder text
    - {field}_required: Boolean
    - {field}_max_chars: Character limit
    - {field}_pattern: letters, numbers, alphanumeric
    - {field}_options: Comma-separated select options
    - {field}_price: Additional price in cents (display only)
  
  Usage:
    {% render 'cart-item-properties-customization',
      product: product,
      fields: 'engraving,gift_message',
      engraving_label: 'Custom Engraving',
      engraving_max_chars: 20
    %}
{% endcomment %}

{%- comment -%} Default values and configuration {%- endcomment -%}
{%- liquid
  assign snippet_enabled = enabled | default: true
  assign field_list = fields | default: 'engraving'
  assign title = section_title | default: 'Personalization'
  assign preview_enabled = show_preview | default: true
  assign preview_font_family = preview_font | default: 'inherit'
  
  # Generate unique ID for this instance to avoid conflicts with multiple products
  assign unique_id = product.id | append: '-' | append: 'now' | md5 | truncate: 8, ''
-%}

