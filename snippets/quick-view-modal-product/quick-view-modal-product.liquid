  assign button_text = button_text | default: 'Quick View'
  assign show_vendor = show_vendor | default: true
  assign show_sku = show_sku | default: false
  assign show_share = show_share | default: true
  assign enable_video = enable_video | default: true
  assign image_size = image_size | default: 'large'
  assign max_thumbnails = max_thumbnails | default: 5
  
  # Determine image dimensions based on size parameter
  case image_size
    when 'small'
      assign main_image_size = '400x400'
      assign thumb_size = '60x60'
    when 'medium'
      assign main_image_size = '600x600'
      assign thumb_size = '80x80'
    else
      assign main_image_size = '800x800'
      assign thumb_size = '100x100'
  endcase
