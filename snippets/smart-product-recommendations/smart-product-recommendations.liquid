## File 2: smart-product-recommendations.liquid

```liquid
{% comment %}
  Smart Product Recommendations Section
  =====================================
  
  A personalized product recommendation engine that works without external apps.
  
  Algorithm Priority:
  1. Products from browsing history that match current product tags
  2. Products matching the most tags with current product
  3. Products from the same collection
  4. Fallback collection products
  5. Best-selling products as final fallback
  
  Performance Considerations:
  - Uses lazy loading for images
  - Intersection Observer for viewport detection
  - Minimal DOM operations
  - No external API calls
  
  Accessibility:
  - Full ARIA support
  - Keyboard navigation
  - Screen reader friendly
  - Reduced motion support
  
  @param {string} heading - Section heading text
  @param {number} products_to_show - Number of products to display (2-12)
  @param {boolean} enable_browsing_history - Track user browsing history
  @param {boolean} enable_tag_matching - Match products by tags
  @param {boolean} enable_same_collection - Include same collection products
  @param {collection} fallback_collection - Fallback collection handle
{% endcomment %}

{%- liquid
  # Section Settings
  assign heading = section.settings.heading
  assign products_to_show = section.settings.products_to_show | default: 4
  assign enable_browsing_history = section.settings.enable_browsing_history
  assign enable_tag_matching = section.settings.enable_tag_matching
  assign enable_same_collection = section.settings.enable_same_collection
  assign fallback_collection = section.settings.fallback_collection
  assign show_vendor = section.settings.show_vendor
  assign show_rating = section.settings.show_rating
  assign card_style = section.settings.card_style | default: 'standard'
  assign columns_desktop = section.settings.columns_desktop | default: 4
  assign columns_mobile = section.settings.columns_mobile | default: 2
  
  # Initialize recommendation arrays
  assign recommended_products = '' | split: ','
  assign recommended_ids = '' | split: ','
  assign current_product_tags = product.tags | join: '|||'
  
  # Get current product's collections for collection-based matching
  assign current_collections = product.collections | map: 'handle' | join: '|||'
-%}

