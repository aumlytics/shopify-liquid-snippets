    cursor: pointer;
    transition: all var(--pta-transition-duration) ease;
    white-space: nowrap;
    font-family: inherit;
  }

  .pta-tabs__button:hover {
    color: var(--pta-primary-color);
    background-color: var(--pta-hover-color);
